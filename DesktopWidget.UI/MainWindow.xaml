<Window x:Class="DesktopWidget.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DesktopWidget.UI" Title="Codex - Usage Limits">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootLayout" Padding="20,16,20,14" RowSpacing="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="6" Margin="-6,0,-6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Codex">
                    <Run Text="Codex" FontWeight="SemiBold"/>
                </TextBlock>
                <Border Grid.Column="1" Padding="6,2" CornerRadius="4" MaxWidth="90"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay}"
                        Opacity="{x:Bind ViewModel.PeriodsOpacity, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PlanDescription, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.PlanLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"
                            AutomationProperties.Name="{x:Bind ViewModel.PlanDescription, Mode=OneWay}"/>
                </Border>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Usage Limits">
                    <Run Text=" - Usage Limits" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </TextBlock>
            </Grid>
            <Grid Grid.Column="2" Width="28" Height="28">
                <Button Click="RefreshClick" Visibility="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" Padding="6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Refresh limits" AutomationProperties.Name="Refresh limits">
                    <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                </Button>
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" ToolTipService.ToolTip="Updating limits" AutomationProperties.Name="Updating limits"/>
            </Grid>
            <Button Grid.Column="3" Padding="6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="12"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutSubItem x:Name="UpdateIntervalMenu" Text="Update Interval"/>
                        <MenuFlyoutSubItem x:Name="TintOpacityMenu" Text="Acrylic Tint Opacity"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="{x:Bind ViewModel.Status, Mode=OneWay}" IsEnabled="False"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="4" Click="HideClick" Padding="6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Hide to tray" AutomationProperties.Name="Hide to tray">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Periods}" Opacity="{x:Bind ViewModel.PeriodsOpacity, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="18"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:UsagePeriodViewModel">
                            <StackPanel Spacing="7">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind RemainingText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <ProgressBar Minimum="0" Maximum="100" local:AnimatedProgress.Target="{x:Bind Remaining, Mode=OneWay}" Height="4" AutomationProperties.Name="{x:Bind AccessibleLabel, Mode=OneWay}" Visibility="{x:Bind IsNormal, Mode=OneWay}"/>
                                    <ProgressBar Minimum="0" Maximum="100" local:AnimatedProgress.Target="{x:Bind Remaining, Mode=OneWay}" Height="4" Foreground="Coral" AutomationProperties.Name="{x:Bind AccessibleLabel, Mode=OneWay}" Visibility="{x:Bind IsLow, Mode=OneWay}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ResetText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ResetText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Countdown, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>


